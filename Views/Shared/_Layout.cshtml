@inject StoreService Store
@{
    var user=Store.Data.Users.FirstOrDefault(u=>u.Id==Context.Session.GetInt32("UserId"));
}
<!DOCTYPE html>
<html lang="ru">
    <head>
        <meta charset="utf-8"/>
        <meta name="viewport" content="width=device-width, initial-scale=1"/>
        <title>
            @ViewData["Title"] — RENTA
        </title>
        <link rel="stylesheet" href="~/css/site.css" asp-append-version="true"/>
    </head>
    <body>
        <header class="topbar">
            <div class="wrap nav">
                <a class="logo" href="/">
                    renta
                    <span>
                        .
                    </span>
                </a>
                <nav>
                    <a href="/#catalog">
                        Каталог
                    </a>
                    <a href="/#how">
                        Как это работает
                    </a>
                    @if(user!=null)
                    {
                        <a href="/Bookings">
                            Мои аренды
                        </a>
                    }
                    @if(user?.Role is UserRole.Manager or UserRole.Admin)
                    {
                        <a href="/Manager">
                            Менеджер
                        </a>
                    }
                    @if(user?.Role==UserRole.Admin)
                    {
                        <a href="/Admin">
                            Админ
                        </a>
                        <a href="/Stats">
                            Статистика
                        </a>
                    }
                </nav>
                <div class="account">
                    @if(user==null)
                    {
                        <a href="/Home/Login">
                            Войти
                            <span>
                                ↗
                            </span>
                        </a>
                    }
                    else
                    {
                        <span>
                            Привет, @user.Name.Split(' ')[0]
                        </span>
                        <form asp-controller="Home" asp-action="Logout" method="post">
                            @Html.AntiForgeryToken()
                            <button class="link">
                                Выйти
                            </button>
                        </form>
                    }
                </div>
            </div>
        </header>
        <main>
            @if(TempData["Message"]!=null)
            {
                <div class="wrap notice">
                    @TempData["Message"]
                </div>
            }
            @RenderBody()
        </main>
        <footer>
            <div class="wrap footer">
                <div>
                    <a class="logo" href="/">
                        renta
                        <span>
                            .
                        </span>
                    </a>
                    <p>
                        Больше впечатлений.
                        <br/>
                        Меньше лишних вещей.
                    </p>
                </div>
                <div>
                    <b>
                        Навигация
                    </b>
                    <a href="/#catalog">
                        Каталог
                    </a>
                    <a href="/#how">
                        Как это работает
                    </a>
                    <a href="/Bookings">
                        Мои аренды
                    </a>
                </div>
                <div>
                    <b>
                        Контакты
                    </b>
                    <a href="mailto:hello@renta.example">
                        hello@renta.example
                    </a>
                    <p>
                        Ежедневно, 9:00–20:00
                    </p>
                </div>
                <div class="footer-end">
                    Создано для новых
                    <br/>
                    приключений
                    <span>
                        ↗
                    </span>
                </div>
            </div>
            <div class="wrap copyright">
                © @DateTime.Today.Year RENTA · Прокат оборудования
                <span>
                    Учебный проект
                </span>
            </div>
        </footer>
        <script src="~/js/site.js" asp-append-version="true">
        </script>
    </body>
</html>


@model Equipment
@{ ViewData["Title"]="Бронирование"; }
<section class="wrap page"><a class="back" href="/">← Вернуться в каталог</a><div class="booking-layout"><div class="booking-photo"><img src="@Model.ImageUrl" alt="@Model.Name"/></div><div class="booking-info"><div class="eyebrow muted">БРОНИРОВАНИЕ / @Model.Id.ToString("00")</div><h1>@Model.Name<span>.</span></h1><p class="lead">@Model.Description</p><div class="price-big">@Model.PricePerDay.ToString("N0") ₽ <small>/ сутки</small></div><div class="specs"><div><span>Категория</span><b>Оборудование</b></div><div><span>В наличии</span><b>@Model.AvailableUnits из @Model.TotalUnits</b></div></div><form method="post" class="booking-form">@Html.AntiForgeryToken()<div asp-validation-summary="All" class="errors"></div><div class="date-grid"><label>Дата начала<input type="date" name="startDate" min="@DateTime.Today.ToString("yyyy-MM-dd")" value="@DateTime.Today.ToString("yyyy-MM-dd")" required/></label><label>Дата возврата<input type="date" name="endDate" min="@DateTime.Today.ToString("yyyy-MM-dd")" value="@DateTime.Today.AddDays(1).ToString("yyyy-MM-dd")" required/></label></div><button class="btn dark full">Забронировать <span>↗</span></button></form><p class="hint">После бронирования менеджер подтвердит выдачу. Оплата — при получении.</p></div></div></section>



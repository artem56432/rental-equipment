@model List<Equipment>
@{
    ViewData["Title"]="Аренда оборудования";
    var cats=(List<Category>)ViewBag.Categories;
}
<section class="hero">
    <div class="wrap hero-inner">
        <div class="hero-copy">
            <div class="eyebrow">
                <span class="dot">
                </span>
                ПРОКАТ ДЛЯ ЛЮБЫХ ПЛАНОВ
            </div>
            <h1>
                Бери в аренду.
                <br/>
                <em>
                    Живи ярче.
                </em>
            </h1>
            <p>
                Всё, что нужно для приключений, спорта и больших идей. Без лишних покупок и забот о хранении.
            </p>
            <div class="hero-actions">
                <a class="btn dark" href="#catalog">
                    Выбрать оборудование
                    <span>
                        ↗
                    </span>
                </a>
                <a class="text-link" href="#how">
                    Как это работает
                    <span>
                        ↗
                    </span>
                </a>
            </div>
            <div class="hero-proof">
                <div class="avatars">
                    <i>
                        А
                    </i>
                    <i>
                        М
                    </i>
                    <i>
                        К
                    </i>
                </div>
                <div>
                    <b>
                        Для ваших новых историй
                    </b>
                    <small>
                        От выходных до большого проекта
                    </small>
                </div>
            </div>
        </div>
        <div class="hero-photo">
            <div class="photo-label">
                <span>
                    ✳
                </span>
                <div>
                    <b>
                        Меньше вещей.
                    </b>
                    <br/>
                    Больше жизни.
                </div>
            </div>
            <div class="vertical">
                ВРЕМЯ ДЕЙСТВОВАТЬ / 01
            </div>
        </div>
    </div>
</section>
<section class="benefits">
    <div class="wrap benefits-grid">
        <div>
            <span>
                ✳
            </span>
            <p>
                <b>
                    Проверенное оборудование
                </b>
                <small>
                    Готово к работе и приключениям
                </small>
            </p>
        </div>
        <div>
            <span>
                ◷
            </span>
            <p>
                <b>
                    Гибкие сроки аренды
                </b>
                <small>
                    На один день или дольше
                </small>
            </p>
        </div>
        <div>
            <span>
                ↗
            </span>
            <p>
                <b>
                    Всё в одном месте
                </b>
                <small>
                    Спорт, туризм и инструменты
                </small>
            </p>
        </div>
    </div>
</section>
<section class="wrap catalog" id="catalog">
    <div class="section-heading">
        <div>
            <div class="eyebrow muted">
                ПОД ВАШИ ЗАДАЧИ / 01
            </div>
            <h2>
                Найдите то, что нужно
                <span>
                    .
                </span>
            </h2>
            <p>
                Хорошие вещи созданы, чтобы ими пользоваться.
            </p>
        </div>
        <div class="count">
            КАТАЛОГ
            <b>
                @Model.Count.ToString("00")
            </b>
        </div>
    </div>
    <form class="filters" method="get">
        @Html.AntiForgeryToken()
        <div class="chips">
            <button class="chip @(ViewBag.Category==null ? "active" : "")" name="category" value="">
                Всё оборудование
            </button>
            @foreach(var c in cats)
            {
                <button class="chip @(ViewBag.Category?.ToString()==c.Id.ToString()?"active":"")" name="category" value="@c.Id">
                    @c.Name
                </button>
            }
        </div>
        <div class="search">
            <span>
                ⌕
            </span>
            <input name="q" value="@ViewBag.Query" placeholder="Поиск оборудования"/>
            <button aria-label="Найти">
                ↗
            </button>
        </div>
    </form>
    <div class="cards">
        @foreach(var item in Model)
        {
            var cat=cats.FirstOrDefault(c=>c.Id==item.CategoryId);
            <article class="card">
                <a class="card-image" href="/Bookings/Create/@item.Id">
                    <img src="@item.ImageUrl" alt="@item.Name" loading="lazy"/>
                    <span class="badge">
                        @cat?.Name
                    </span>
                    <span class="circle-arrow">
                        ↗
                    </span>
                </a>
                <div class="card-body">
                    <div class="card-meta">
                        <span>
                            ОБОРУДОВАНИЕ / @item.Id.ToString("00")
                        </span>
                        <span class="available">
                            ● @(item.State==EquipmentState.Available?"Доступно":"Недоступно")
                        </span>
                    </div>
                    <h3>
                        @item.Name
                    </h3>
                    <p>
                        @item.Description
                    </p>
                    <div class="card-bottom">
                        <div>
                            <b>
                                @item.PricePerDay.ToString("N0") ₽
                            </b>
                            <small>
                                / сутки
                            </small>
                        </div>
                        <a href="/Bookings/Create/@item.Id">
                            Подробнее
                            <span>
                                ↗
                            </span>
                        </a>
                    </div>
                </div>
            </article>
        }
        @if(Model.Count==0)
        {
            <p>
                Ничего не найдено. Попробуйте изменить запрос или категорию.
            </p>
        }
    </div>
</section>
<section class="how" id="how">
    <div class="wrap">
        <div class="section-heading">
            <div>
                <div class="eyebrow muted">
                    ПРОЩЕ, ЧЕМ КАЖЕТСЯ / 02
                </div>
                <h2>
                    Три шага к делу
                    <span>
                        .
                    </span>
                </h2>
            </div>
            <p>
                Всё просто: выбирайте, бронируйте
                <br/>
                и отправляйтесь навстречу планам.
            </p>
        </div>
        <div class="steps">
            <div>
                <span>
                    01 / ВЫБОР
                </span>
                <b>
                    Найдите своё
                </b>
                <p>
                    Выберите оборудование для работы или отдыха.
                </p>
            </div>
            <div>
                <span>
                    02 / БРОНИРОВАНИЕ
                </span>
                <b>
                    Укажите даты
                </b>
                <p>
                    Выберите удобный период и узнайте стоимость.
                </p>
            </div>
            <div>
                <span>
                    03 / ВПЕРЁД
                </span>
                <b>
                    Заберите и пользуйтесь
                </b>
                <p>
                    Менеджер поможет оформить выдачу.
                </p>
            </div>
        </div>
    </div>
</section>
<section class="wrap cta">
    <div>
        <div class="eyebrow">
            ЕСТЬ ПЛАНЫ?
        </div>
        <h2>
            Время воплощать
            <br/>
            <em>
                задуманное.
            </em>
        </h2>
        <p>
            Нужное оборудование уже ждёт вас.
        </p>
        <a class="btn light" href="#catalog">
            Перейти в каталог
            <span>
                ↗
            </span>
        </a>
    </div>
    <div class="cta-star">
        ✳
    </div>
</section>


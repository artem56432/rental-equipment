@model List<Booking>
@{ ViewData["Title"]="Статистика"; var items=(List<Equipment>)ViewBag.Items; var returned=Model.Where(x=>x.Status==BookingStatus.Returned).ToList(); var active=Model.Count(x=>x.Status is BookingStatus.Booked or BookingStatus.Confirmed or BookingStatus.Issued or BookingStatus.Overdue); }
<section class="wrap page"><div class="page-title"><div><div class="eyebrow muted">АНАЛИТИКА</div><h1>Статистика<span>.</span></h1><p>Все данные по заказам.</p></div></div><div class="stat-grid"><div class="stat-card"><span>СУММА ВОЗВРАЩЁННЫХ АРЕНД</span><b>@returned.Sum(x=>x.TotalPrice).ToString("N0") ₽</b><small>начислено, без учёта оплаты</small></div><div class="stat-card"><span>ЗАКАЗОВ</span><b>@Model.Count</b></div><div class="stat-card"><span>АКТИВНЫЕ</span><b>@active</b></div><div class="stat-card accent"><span>ШТРАФЫ</span><b>@returned.Sum(x=>x.Fine).ToString("N0") ₽</b><small>начислено при возврате</small></div></div><div class="charts"><div class="panel chart"><h2>Заказы по категориям</h2>@foreach(var group in items.GroupBy(i=>i.CategoryId)){var ids=group.Select(x=>x.Id).ToHashSet(); var count=Model.Count(b=>ids.Contains(b.EquipmentId));<div class="bar-row"><span>Категория @group.Key</span><div><i style="width:@(count*100/Math.Max(1,Model.Count))%"></i></div><b>@count</b></div>}</div><div class="panel chart"><h2>Статусы заказов</h2>@foreach(var status in Enum.GetValues<BookingStatus>()){var count=Model.Count(b=>b.Status==status);<div class="bar-row"><span>@(status switch { BookingStatus.Booked=>"Ожидает", BookingStatus.Confirmed=>"Подтверждено", BookingStatus.Issued=>"Выдано", BookingStatus.Overdue=>"Просрочено", BookingStatus.Returned=>"Возвращено", _=>"Отменено" })</span><div><i style="width:@(count*100/Math.Max(1,Model.Count))%"></i></div><b>@count</b></div>}</div></div></section>
